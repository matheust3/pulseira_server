{
  "name": "pulseira_server_dev_container",
  "service": "pulseira_server_dev_container",
  "dockerComposeFile": "./docker-compose.yml",
  //Para copiar o ID do grupo do Docker da máquina host para as variáveis de ambiente do Docker
  //Também cria o DEV_ROOT_DIR
  "initializeCommand": "echo HOST_DOCKER_GROUP_ID=$(getent group docker | cut -d: -f3)'\n'DEV_ROOT_DIR=$(pwd)'\n'MINIO_ROOT_USER=pulseira_server_minio_user'\n'MINIO_ROOT_PASSWORD=pulseira_server_minio_pass > .devcontainer/.env",
  "workspaceFolder": "/home/developer/dev",
  "postStartCommand": "npm install -g npm && npm i && npx husky init && npm install -g nextui-cli",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "streetsidesoftware.code-spell-checker-portuguese-brazilian",
        "dbaeumer.vscode-eslint",
        "prisma.prisma",
        "bradlc.vscode-tailwindcss",
        "postman.postman-for-vscode",
        "github.vscode-github-actions"
      ]
    }
  }
}