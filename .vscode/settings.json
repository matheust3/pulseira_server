{
  "cSpell.words": [
    "presigner",
    "usecase",
    "usecases",
    "crm"
  ],
  "[typescript]": {
    "editor.formatOnSave": false
  },
  "[typescriptreact]": {
    "editor.formatOnSave": false
  },
  "editor.codeActionsOnSave": {
    "source.fixAll": "always",
    "source.fixAll.eslint": "always",
  },
  "eslint.options": {
    "overrideConfigFile": ".eslintrc.json"
  },
  "postman.settings.dotenv-detection-notification-visibility": false
}